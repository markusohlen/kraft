{
  "name": "kraft",
  "version": "0.1.2",
  "description": "A desktop Git client with a commit graph, auto-stash workflow and git-flow.",
  "main": "./out/main/index.js",
  "private": true,
  "scripts": {
    "dev": "electron-vite dev --watch",
    "build": "electron-vite build",
    "start": "electron-vite preview",
    "typecheck": "tsc --noEmit",
    "test": "vitest run",
    "icon": "electron scripts/render-icon.mjs",
    "dist": "electron-vite build && electron-builder --publish never"
  },
  "license": "MIT",
  "author": "markusohlen",
  "build": {
    "appId": "com.markusohlen.kraft",
    "productName": "Kraft",
    "directories": { "output": "release" },
    "icon": "build/icon.png",
    "files": ["out/**/*"],
    "win": { "target": "nsis" },
    "nsis": { "oneClick": true, "perMachine": false, "artifactName": "${productName}-Setup-${version}.${ext}" },
    "mac": { "target": "dmg", "identity": null },
    "linux": { "target": "AppImage", "category": "Development" },
    "publish": { "provider": "github", "owner": "markusohlen", "repo": "kraft" }
  },
  "dependencies": {
    "electron-updater": "^6.8.10",
    "prismjs": "^1.30.0",
    "react": "^19.3.1",
    "react-dom": "^19.3.1"
  },
  "devDependencies": {
    "@types/node": "^24.19.2",
    "@types/prismjs": "^1.26.5",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "@vitejs/plugin-react": "^6.1.2",
    "electron": "^44.9.1",
    "electron-builder": "^26.15.3",
    "electron-vite": "^6.0.0",
    "typescript": "^5.9.3",
    "vite": "^8.3.4",
    "vitest": "^5.0.4"
  }
}
